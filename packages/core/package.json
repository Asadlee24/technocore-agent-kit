{
  "name": "@technocore/agent-kit",
  "version": "1.0.0",
  "description": "Autonomous AI Agent Kit & TypeScript SDK for Technocore Protocol",
  "author": "Asad Lee <https://asad-lee-portfolio.vercel.app/>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "technocore-agent": "./dist/src/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./identity": {
      "types": "./dist/src/identity/index.d.ts",
      "import": "./dist/src/identity/index.js"
    },
    "./rooms": {
      "types": "./dist/src/rooms/index.d.ts",
      "import": "./dist/src/rooms/index.js"
    },
    "./notes": {
      "types": "./dist/src/notes/index.d.ts",
      "import": "./dist/src/notes/index.js"
    },
    "./verify": {
      "types": "./dist/src/verify/index.d.ts",
      "import": "./dist/src/verify/index.js"
    },
    "./safety": {
      "types": "./dist/src/safety/index.d.ts",
      "import": "./dist/src/safety/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp/index.d.ts",
      "import": "./dist/src/mcp/index.js"
    },
    "./proof": {
      "types": "./dist/src/proof/index.d.ts",
      "import": "./dist/src/proof/index.js"
    },
    "./tasks": {
      "types": "./dist/src/tasks/index.d.ts",
      "import": "./dist/src/tasks/index.js"
    },
    "./registry": {
      "types": "./dist/src/registry/index.d.ts",
      "import": "./dist/src/registry/index.js"
    },
    "./router": {
      "types": "./dist/src/router/index.d.ts",
      "import": "./dist/src/router/index.js"
    },
    "./orchestrator": {
      "types": "./dist/src/orchestrator/index.d.ts",
      "import": "./dist/src/orchestrator/index.js"
    },
    "./providers": {
      "types": "./dist/src/providers/index.d.ts",
      "import": "./dist/src/providers/index.js"
    },
    "./memory": {
      "types": "./dist/src/memory/index.d.ts",
      "import": "./dist/src/memory/index.js"
    },
    "./events": {
      "types": "./dist/src/events/index.d.ts",
      "import": "./dist/src/events/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/identity.test.js dist/test/notes.test.js dist/test/proof.test.js dist/test/rooms.test.js dist/test/safety.test.js dist/test/tasks.test.js dist/test/state-machine.test.js dist/test/registry-router.test.js dist/test/verifiable-result.test.js dist/test/security-permissions.test.js dist/test/memory.test.js dist/test/workflow-engine.test.js dist/test/providers.test.js dist/test/e2e-orchestrator.test.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
